---
import Tag from "../Tag.astro";

interface Props {
  title: string;
  slug: string;
  date: Date;
  reading_time?: string | number;
  description?: string;
  tags?: string[];
  topic_hub?: string;
  topic_hub_title?: string;
  featured?: boolean;
}

const {
  title,
  slug,
  date,
  reading_time,
  description,
  tags = [],
  topic_hub,
  topic_hub_title,
  featured = false,
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
}).format(new Date(date));

const readTimeText = typeof reading_time === "number" ? `${reading_time} min read` : reading_time || "";
---

<article class={`research-card ${featured ? "research-card--featured" : ""}`}>
  <div class="research-card__meta">
    <div class="cluster" style="--cluster-gap: var(--space-2xs); align-items: center;">
      <span class="research-badge">Research Monograph</span>
      {topic_hub && (
        <a href={`/topics/${topic_hub}`} class="research-hub-pill">
          {topic_hub_title || topic_hub}
        </a>
      )}
    </div>
    <div class="research-card__timing muted">
      <time datetime={new Date(date).toISOString()}>{formattedDate}</time>
      {readTimeText && <span> · {readTimeText}</span>}
    </div>
  </div>

  <h3 class="research-card__title">
    <a href={`/research/${slug}`} class="research-card__link">
      {title}
    </a>
  </h3>

  {description && (
    <div class="research-card__abstract">
      <span class="abstract-label">Abstract:</span>
      <p class="abstract-text">{description}</p>
    </div>
  )}

  <div class="research-card__footer">
    {tags.length > 0 && (
      <div class="research-card__tags cluster" style="--cluster-gap: var(--space-3xs)">
        {tags.slice(0, 4).map((tag) => (
          <Tag text={tag} href={`/writing?tag=${encodeURIComponent(tag)}`} />
        ))}
      </div>
    )}
    <a href={`/research/${slug}`} class="research-card__cta">
      Read Monograph <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .research-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-l);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
    position: relative;
  }

  .research-card--featured {
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-accent) 4%, var(--color-surface)) 0%,
      var(--color-surface) 100%
    );
    border-color: var(--color-border);
    border-left: 4px solid var(--color-accent);
  }

  .research-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md, 0 4px 12px rgba(0, 0, 0, 0.05));
  }

  .research-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-xs);
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .research-badge {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm, 4px);
    background-color: color-mix(in srgb, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
  }

  .research-hub-pill {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--color-text-secondary);
    text-decoration: none;
    border: 1px solid var(--color-border);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm, 4px);
    transition: all var(--transition-fast);
  }

  .research-hub-pill:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .research-card__timing {
    font-family: var(--font-body);
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  .research-card__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    margin-bottom: var(--space-xs);
  }

  .research-card__link {
    color: var(--color-text);
    text-decoration: none;
  }

  .research-card__link:hover {
    color: var(--color-accent);
  }

  .research-card__abstract {
    background-color: color-mix(in srgb, var(--color-bg) 60%, transparent);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm, 4px);
    padding: var(--space-s);
    margin-bottom: var(--space-m);
  }

  .abstract-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3xs);
  }

  .abstract-text {
    font-family: var(--font-body);
    font-size: var(--step--1);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    margin: 0;
  }

  .research-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  .research-card__cta {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    color: var(--color-accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: gap var(--transition-fast);
    margin-left: auto;
  }

  .research-card__cta:hover {
    gap: 0.55rem;
  }
</style>
