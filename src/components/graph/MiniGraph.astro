---
// MiniGraph.astro - Dynamic interactive network graph connecting topics and 6 most recent blog posts
import { getPublishedPosts } from "../../utils/posts";
import { getCollection } from "astro:content";

const topics = await getCollection("topics");
const sortedPosts = await getPublishedPosts();
const recentPosts = sortedPosts.slice(0, 6);

const initialNodes = [
  ...topics.map((t) => ({
    id: t.id,
    label: t.data.title,
    type: "topic",
    r: 16,
    url: `/topics/${t.id}`,
  })),
  ...recentPosts.map((p) => ({
    id: p.id,
    label: p.data.title,
    type: "post",
    r: 8,
    url: `/writing/${p.id}`,
  })),
];

// Generate links
const initialLinks: { source: string; target: string }[] = [];

// 1. Topic-to-topic mesh
for (let i = 0; i < topics.length; i++) {
  const current = topics[i];
  const next = topics[(i + 1) % topics.length];
  if (current && next && current.id !== next.id) {
    initialLinks.push({ source: current.id, target: next.id });
  }
}

// 2. Post-to-topic links
recentPosts.forEach((post) => {
  let linked = false;
  const postTopics = post.data.topics || [];
  const postTags = (post.data.tags || []).map((t: string) => t.toLowerCase());

  topics.forEach((topic) => {
    const isTopicMatch = postTopics.includes(topic.id);
    const isTagMatch = postTags.some((tag: string) =>
      topic.id.includes(tag) || tag.includes(topic.id) || topic.data.title.toLowerCase().includes(tag)
    );

    if (isTopicMatch || isTagMatch) {
      initialLinks.push({ source: post.id, target: topic.id });
      linked = true;
    }
  });

  // Fallback: If no topic matched directly, link to the first topic
  if (!linked && topics.length > 0) {
    initialLinks.push({ source: post.id, target: topics[0].id });
  }
});
---

<div class="mini-graph" data-mini-graph>
  <div class="mini-graph__header">
    <span class="kicker">Live Knowledge Graph</span>
    <a href="/explorer" class="mini-graph__link">Open Full Explorer →</a>
  </div>
  <canvas class="mini-graph__canvas" id="miniGraphCanvas" aria-label="Interactive map of AI systems engineering topics and blog posts"></canvas>
  <div class="mini-graph__tooltip" id="graphTooltip" hidden></div>
</div>

<style>
  .mini-graph {
    position: relative;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    overflow: hidden;
    margin-block: var(--space-l);
  }

  .mini-graph__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-xs) var(--space-s);
    border-bottom: 1px solid var(--color-border-subtle);
    background-color: var(--color-bg);
  }

  .mini-graph__link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-accent);
    text-decoration: none;
  }

  .mini-graph__link:hover {
    text-decoration: underline;
  }

  .mini-graph__canvas {
    width: 100%;
    height: 320px;
    display: block;
    cursor: grab;
  }

  .mini-graph__canvas:active {
    cursor: grabbing;
  }

  .mini-graph__tooltip {
    position: absolute;
    pointer-events: none;
    background-color: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.35rem 0.6rem;
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--color-text);
    box-shadow: var(--shadow-md);
    transform: translate(-50%, -120%);
    white-space: nowrap;
    z-index: 10;
    transition: opacity var(--transition-fast);
  }
</style>

<script is:inline define:vars={{ initialNodes, initialLinks }}>
  function initMiniGraph() {
    const canvas = document.getElementById("miniGraphCanvas");
    const tooltip = document.getElementById("graphTooltip");
    if (!canvas || !initialNodes || !initialLinks) return;

    const ctx = canvas.getContext("2d");
    const dpr = window.devicePixelRatio || 1;

    function resize() {
      const rect = canvas.getBoundingClientRect();
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      ctx.scale(dpr, dpr);
    }
    resize();
    window.addEventListener("resize", resize);

    const rect = canvas.getBoundingClientRect();
    const width = rect.width;
    const height = rect.height;

    // Deep copy nodes for interactive state
    const nodes = initialNodes.map((n, i) => {
      const angle = (i / initialNodes.length) * Math.PI * 2;
      const radius = n.type === "topic" ? 75 : 120;
      return {
        ...n,
        x: width / 2 + Math.cos(angle) * radius + (Math.random() - 0.5) * 20,
        y: height / 2 + Math.sin(angle) * radius + (Math.random() - 0.5) * 20,
        vx: 0,
        vy: 0,
      };
    });

    const links = initialLinks.map((l) => ({ ...l }));

    // Initialize random positions near center
    nodes.forEach((n, i) => {
      const angle = (i / nodes.length) * Math.PI * 2;
      const radius = n.type === "topic" ? 70 : 120;
      n.x = width / 2 + Math.cos(angle) * radius + (Math.random() - 0.5) * 20;
      n.y = height / 2 + Math.sin(angle) * radius + (Math.random() - 0.5) * 20;
      n.vx = 0;
      n.vy = 0;
    });

    let hoveredNode = null;
    let draggedNode = null;

    function stepPhysics() {
      // Repulsion between nodes
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const a = nodes[i];
          const b = nodes[j];
          const dx = b.x - a.x;
          const dy = b.y - a.y;
          const dist = Math.sqrt(dx * dx + dy * dy) || 1;
          const force = (1200 / (dist * dist));
          const fx = (dx / dist) * force;
          const fy = (dy / dist) * force;
          a.vx -= fx;
          a.vy -= fy;
          b.vx += fx;
          b.vy += fy;
        }
      }

      // Spring links
      links.forEach((l) => {
        const a = typeof l.source === "string" ? nodes.find((n) => n.id === l.source) : l.source;
        const b = typeof l.target === "string" ? nodes.find((n) => n.id === l.target) : l.target;
        if (!a || !b) return;
        const dx = b.x - a.x;
        const dy = b.y - a.y;
        const dist = Math.sqrt(dx * dx + dy * dy) || 1;
        const targetDist = 75;
        const force = (dist - targetDist) * 0.03;
        const fx = (dx / dist) * force;
        const fy = (dy / dist) * force;
        a.vx += fx;
        a.vy += fy;
        b.vx -= fx;
        b.vy -= fy;
      });

      // Center gravity & damping
      const cx = width / 2;
      const cy = height / 2;
      nodes.forEach((n) => {
        if (n === draggedNode) return;
        n.vx += (cx - n.x) * 0.005;
        n.vy += (cy - n.y) * 0.005;
        n.vx *= 0.85;
        n.vy *= 0.85;
        n.x += n.vx;
        n.y += n.vy;

        // Boundaries
        const pad = n.r + 10;
        n.x = Math.max(pad, Math.min(width - pad, n.x));
        n.y = Math.max(pad, Math.min(height - pad, n.y));
      });
    }

    function render() {
      stepPhysics();
      ctx.clearRect(0, 0, width, height);

      const isDark = document.documentElement.dataset.theme === "dark";
      const topicColor = isDark ? "#e09f67" : "#b85d19";
      const postColor = isDark ? "#6fa882" : "#3b7a54";

      // Compute neighborhood for hovered node
      const connectedNodeIds = new Set();
      const connectedLinkSet = new Set();

      if (hoveredNode) {
        connectedNodeIds.add(hoveredNode.id);
        links.forEach((l) => {
          const aId = typeof l.source === "string" ? l.source : l.source.id;
          const bId = typeof l.target === "string" ? l.target : l.target.id;
          if (aId === hoveredNode.id || bId === hoveredNode.id) {
            connectedNodeIds.add(aId);
            connectedNodeIds.add(bId);
            connectedLinkSet.add(l);
          }
        });
      }

      // Draw links
      if (!hoveredNode) {
        ctx.beginPath();
        ctx.strokeStyle = isDark ? "rgba(255, 255, 255, 0.12)" : "rgba(0, 0, 0, 0.08)";
        ctx.lineWidth = 1.5;
        links.forEach((l) => {
          const a = typeof l.source === "string" ? nodes.find((n) => n.id === l.source) : l.source;
          const b = typeof l.target === "string" ? nodes.find((n) => n.id === l.target) : l.target;
          if (!a || !b) return;
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
        });
        ctx.stroke();
      } else {
        // Dimmed background links
        ctx.beginPath();
        ctx.strokeStyle = isDark ? "rgba(255, 255, 255, 0.02)" : "rgba(0, 0, 0, 0.02)";
        ctx.lineWidth = 0.8;
        links.forEach((l) => {
          if (!connectedLinkSet.has(l)) {
            const a = typeof l.source === "string" ? nodes.find((n) => n.id === l.source) : l.source;
            const b = typeof l.target === "string" ? nodes.find((n) => n.id === l.target) : l.target;
            if (!a || !b) return;
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
          }
        });
        ctx.stroke();

        // Highlighted links
        ctx.beginPath();
        ctx.strokeStyle = isDark ? "rgba(224, 159, 103, 0.9)" : "rgba(184, 93, 25, 0.85)";
        ctx.lineWidth = 2.4;
        connectedLinkSet.forEach((l) => {
          const a = typeof l.source === "string" ? nodes.find((n) => n.id === l.source) : l.source;
          const b = typeof l.target === "string" ? nodes.find((n) => n.id === l.target) : l.target;
          if (!a || !b) return;
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
        });
        ctx.stroke();
      }

      // Draw nodes
      nodes.forEach((n) => {
        const isHovered = hoveredNode && n.id === hoveredNode.id;
        const isConnected = hoveredNode ? connectedNodeIds.has(n.id) : true;

        if (hoveredNode) {
          if (isHovered) ctx.globalAlpha = 1.0;
          else if (isConnected) ctx.globalAlpha = 0.95;
          else ctx.globalAlpha = 0.15; // Dimmed
        } else {
          ctx.globalAlpha = 1.0;
        }

        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        ctx.fillStyle = n.type === "topic" ? topicColor : postColor;
        ctx.fill();

        if (isHovered) {
          ctx.lineWidth = 3;
          ctx.strokeStyle = isDark ? "#ffffff" : "#000000";
          ctx.stroke();
        } else if (hoveredNode && isConnected) {
          ctx.lineWidth = 1.5;
          ctx.strokeStyle = isDark ? "rgba(255, 255, 255, 0.75)" : "rgba(0, 0, 0, 0.65)";
          ctx.stroke();
        }

        // Label for topic nodes or connected nodes when hovered
        const shouldShowLabel = hoveredNode ? isConnected : (n.type === "topic");
        if (shouldShowLabel) {
          ctx.font = isHovered ? "700 11px system-ui, sans-serif" : "600 11px system-ui, sans-serif";
          ctx.fillStyle = isDark ? "#f0ebe1" : "#1f1d1a";
          ctx.textAlign = "center";
          const labelText = n.type === "topic" ? n.label : (n.label.length > 25 ? n.label.slice(0, 24) + "…" : n.label);
          ctx.fillText(labelText, n.x, n.y + n.r + 14);
        }

        ctx.globalAlpha = 1.0;
      });

      requestAnimationFrame(render);
    }

    render();

    function getMousePos(e) {
      const r = canvas.getBoundingClientRect();
      return { x: e.clientX - r.left, y: e.clientY - r.top };
    }

    canvas.addEventListener("mousemove", (e) => {
      const pos = getMousePos(e);
      let found = null;
      for (const n of nodes) {
        const dx = n.x - pos.x;
        const dy = n.y - pos.y;
        if (Math.sqrt(dx * dx + dy * dy) < n.r + 6) {
          found = n;
          break;
        }
      }
      hoveredNode = found;
      canvas.style.cursor = found ? "pointer" : (draggedNode ? "grabbing" : "grab");

      if (found && tooltip) {
        tooltip.textContent = `${found.label} (${found.type.toUpperCase()})`;
        tooltip.style.left = `${found.x}px`;
        tooltip.style.top = `${found.y - found.r - 8}px`;
        tooltip.hidden = false;
      } else if (tooltip) {
        tooltip.hidden = true;
      }

      if (draggedNode) {
        draggedNode.x = pos.x;
        draggedNode.y = pos.y;
      }
    });

    canvas.addEventListener("mouseleave", () => {
      hoveredNode = null;
      if (tooltip) tooltip.hidden = true;
    });

    canvas.addEventListener("mousedown", (e) => {
      const pos = getMousePos(e);
      for (const n of nodes) {
        const dx = n.x - pos.x;
        const dy = n.y - pos.y;
        if (Math.sqrt(dx * dx + dy * dy) < n.r + 6) {
          draggedNode = n;
          break;
        }
      }
    });

    // Touch support for mobile devices
    canvas.addEventListener("touchstart", (e) => {
      if (!e.touches || e.touches.length === 0) return;
      const touch = e.touches[0];
      const r = canvas.getBoundingClientRect();
      const pos = { x: touch.clientX - r.left, y: touch.clientY - r.top };
      let found = null;
      for (const n of nodes) {
        const dx = n.x - pos.x;
        const dy = n.y - pos.y;
        if (Math.sqrt(dx * dx + dy * dy) < n.r + 10) {
          found = n;
          break;
        }
      }
      if (found) {
        draggedNode = found;
        hoveredNode = found;
        if (tooltip) {
          tooltip.textContent = `${found.label} (${found.type.toUpperCase()})`;
          tooltip.style.left = `${found.x}px`;
          tooltip.style.top = `${found.y - found.r - 8}px`;
          tooltip.hidden = false;
        }
        e.preventDefault();
      }
    }, { passive: false });

    canvas.addEventListener("touchmove", (e) => {
      if (draggedNode && e.touches && e.touches.length > 0) {
        const touch = e.touches[0];
        const r = canvas.getBoundingClientRect();
        draggedNode.x = touch.clientX - r.left;
        draggedNode.y = touch.clientY - r.top;
        if (tooltip) {
          tooltip.style.left = `${draggedNode.x}px`;
          tooltip.style.top = `${draggedNode.y - draggedNode.r - 8}px`;
        }
        e.preventDefault();
      }
    }, { passive: false });

    canvas.addEventListener("touchend", () => {
      draggedNode = null;
    });

    window.addEventListener("mouseup", () => {
      draggedNode = null;
    });

    canvas.addEventListener("click", () => {
      if (hoveredNode && hoveredNode.url) {
        window.location.href = hoveredNode.url;
      }
    });
  }

  initMiniGraph();
  document.addEventListener("astro:after-swap", initMiniGraph);
</script>
