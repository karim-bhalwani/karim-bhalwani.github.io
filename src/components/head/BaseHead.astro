---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  // Article-specific (used when type === "article")
  publishedTime?: string;
  modifiedTime?: string;
  authorName?: string;
  articleTags?: string[];
  doi?: string;
  noindex?: boolean;
  readingTime?: number | string;
  schemaType?: "BlogPosting" | "TechArticle" | "ScholarlyArticle" | "Article";
  googleSiteVerification?: string;
  bingSiteVerification?: string;
}

const {
  title = "Karim Bhalwani | Writing on AI Systems & Agentic Architecture",
  description = "Personal writing on AI systems reliability, agent control layers, context engineering, and production systems design. Independent learning | not affiliated with any employer.",
  image = "/assets/og-image.png",
  type = "website",
  noindex = false,
  readingTime,
  publishedTime,
  modifiedTime,
  authorName = "Karim Bhalwani",
  articleTags = [],
  doi,
  schemaType,
  googleSiteVerification,
  bingSiteVerification,
} = Astro.props;

const googleVerification = googleSiteVerification || import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = bingSiteVerification || import.meta.env.PUBLIC_BING_SITE_VERIFICATION;

const siteOrigin = Astro.site ? Astro.site.origin : "https://karim-bhalwani.github.io";
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);
const isArticle = type === "article";
const imageURL = image ? new URL(image, canonicalURL.origin).href : undefined;

// Determine article schema type: TechArticle for research/monographs, BlogPosting for writing/posts
const effectiveArticleType = schemaType || (Astro.url.pathname.startsWith("/research") ? "TechArticle" : "BlogPosting");

// Author entity data for Knowledge Graph & E-E-A-T
const authorSameAs = [
  "https://github.com/karim-bhalwani",
  "https://linkedin.com/in/karim-bhalwani",
];
const knowsAboutTopics = [
  "Artificial Intelligence Systems",
  "Agentic Architecture",
  "Context Engineering",
  "Multi-Agent Orchestration",
  "AI Governance & Safety",
  "Production Systems Design",
];

// Build BreadcrumbList Schema for Google Search Snippets
const pathSegments = Astro.url.pathname.split("/").filter(Boolean);
const breadcrumbItems = [
  {
    "@type": "ListItem",
    position: 1,
    name: "Home",
    item: siteOrigin + "/",
  },
];

let accumulatedPath = "";
pathSegments.forEach((segment, idx) => {
  accumulatedPath += `/${segment}`;
  const isLast = idx === pathSegments.length - 1;
  const segmentName = isLast
    ? title.split("|")[0].trim()
    : segment.charAt(0).toUpperCase() + segment.slice(1);

  breadcrumbItems.push({
    "@type": "ListItem",
    position: idx + 2,
    name: segmentName,
    item: new URL(`${accumulatedPath}/`, siteOrigin).href,
  });
});

const breadcrumbSchema = pathSegments.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems,
} : null;

// Build Main Structured Data (Schema.org)
let mainSchema: Record<string, any> | null = null;

if (isArticle) {
  mainSchema = {
    "@context": "https://schema.org",
    "@type": effectiveArticleType,
    headline: title.split("|")[0].trim(),
    description: description,
    image: imageURL,
    url: canonicalURL.href,
    datePublished: publishedTime,
    dateModified: modifiedTime || publishedTime,
    isPartOf: {
      "@type": "WebSite",
      "@id": `${siteOrigin}/#website`,
      name: "Karim Bhalwani",
      url: siteOrigin,
    },
    author: {
      "@type": "Person",
      name: authorName,
      url: `${siteOrigin}/about`,
      sameAs: authorSameAs,
      jobTitle: "Solutions Architect & AI Systems Engineer",
    },
    publisher: {
      "@type": "Person",
      name: "Karim Bhalwani",
      url: siteOrigin,
      sameAs: authorSameAs,
    },
    keywords: articleTags.join(", "),
    inLanguage: "en-US",
    license: "https://creativecommons.org/licenses/by-nc/4.0/",
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": canonicalURL.href,
    },
  };

  if (readingTime) {
    const minutes = parseInt(String(readingTime), 10);
    if (!isNaN(minutes)) {
      mainSchema.timeRequired = `PT${minutes}M`;
    }
  }

  if (effectiveArticleType === "TechArticle") {
    mainSchema.proficiencyLevel = "Expert";
    if (description) {
      mainSchema.abstract = description;
    }
  }

  if (doi) {
    mainSchema.identifier = {
      "@type": "PropertyValue",
      propertyID: "DOI",
      value: doi,
    };
  }
} else {
  // WebSite and Person Schema on non-article pages (Homepage, About, Topics, Archive)
  mainSchema = {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": `${siteOrigin}/#website`,
        url: siteOrigin,
        name: "Karim Bhalwani",
        description: "Personal writing on AI systems reliability, agentic architectures, and production systems design.",
        publisher: {
          "@id": `${siteOrigin}/#author`,
        },
        inLanguage: "en-US",
      },
      {
        "@type": "Person",
        "@id": `${siteOrigin}/#author`,
        name: "Karim Bhalwani",
        url: `${siteOrigin}/about`,
        jobTitle: "Solutions Architect & AI Systems Engineer",
        description: "Architect writing about agent control layers, context engineering, and autonomous systems in production.",
        sameAs: authorSameAs,
        knowsAbout: knowsAboutTopics,
      },
    ],
  };
}
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="canonical" href={canonicalURL} />

<!-- Search Engine Robots Directives & Google Discover Eligibility -->
<meta
  name="robots"
  content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
/>

{googleVerification && (
  <meta name="google-site-verification" content={googleVerification} />
)}
{bingVerification && (
  <meta name="msvalidate.01" content={bingVerification} />
)}

<!-- Favicons & App Icons for Google Search and Browser Tabs -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/favicon.svg" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Google Fonts Preconnect & Optimized Loading for Core Web Vitals -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,300..900;1,300..900&family=Literata:ital,opsz,wght@0,7..72,200..900;1,7..72,200..900&family=JetBrains+Mono:ital,wght@0,400..700;1,400..700&display=swap"
/>

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={authorName} />

<!-- Academic & Scholarly Metadata (Highwire Press / Google Scholar) -->
{isArticle && (
  <>
    <meta name="citation_title" content={title.split("|")[0].trim()} />
    <meta name="citation_author" content={authorName} />
    {publishedTime && (
      <meta name="citation_publication_date" content={publishedTime.split("T")[0].replace(/-/g, "/")} />
    )}
    {doi && <meta name="citation_doi" content={doi} />}
    <meta name="citation_fulltext_html_url" content={canonicalURL.href} />
  </>
)}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{imageURL && (
  <>
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:image:type" content={imageURL.endsWith(".png") ? "image/png" : "image/webp"} />
    <meta property="og:image:alt" content={title.split("|")[0].trim()} />
  </>
)}
<meta property="og:site_name" content="Karim Bhalwani" />

<!-- Article-specific Open Graph -->
{isArticle && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{isArticle && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime} />
)}
{isArticle && (
  <meta property="article:author" content={authorName} />
)}
{isArticle && articleTags.map((tag) => (
  <meta property="article:tag" content={tag} />
))}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
{imageURL && <meta property="twitter:image" content={imageURL} />}

<!-- RSS Feed Autodiscovery -->
<link rel="alternate" type="application/rss+xml" title="Karim Bhalwani | Writing" href="/rss.xml" />

<!-- JSON-LD Main Structured Data -->
{mainSchema && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(mainSchema)} />
)}

<!-- JSON-LD Breadcrumbs for Search Result Navigation Paths -->
{breadcrumbSchema && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
)}
