---
import ThemeToggle from "./ThemeToggle.astro";

const navItems = [
  { label: "Writing", href: "/writing" },
  { label: "Research", href: "/research" },
  { label: "Topics", href: "/topics" },
  { label: "Explorer", href: "/explorer" },
  { label: "About", href: "/about" },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand">
      <span class="brand-name">Karim Bhalwani</span>
      <span class="brand-tagline">AI Systems &amp; Agentic Architecture</span>
    </a>

    <!-- Desktop nav -->
    <nav class="site-nav" aria-label="Main Navigation">
      <ul role="list" class="site-nav__list">
        {
          navItems.map((item) => {
            const isActive = currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href));
            return (
              <li>
                <a
                  href={item.href}
                  class={`site-nav__link ${isActive ? "site-nav__link--active" : ""}`}
                  aria-current={isActive ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <ThemeToggle />
      <!-- Hamburger toggle (mobile only) -->
      <button
        class="hamburger"
        id="hamburgerBtn"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobileDrawer"
      >
        <span class="hamburger__bar"></span>
        <span class="hamburger__bar"></span>
        <span class="hamburger__bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div class="mobile-drawer" id="mobileDrawer" aria-hidden="true">
    <nav aria-label="Mobile Navigation">
      <ul role="list" class="mobile-nav__list">
        {
          navItems.map((item) => {
            const isActive = currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href));
            return (
              <li>
                <a
                  href={item.href}
                  class={`mobile-nav__link ${isActive ? "mobile-nav__link--active" : ""}`}
                  aria-current={isActive ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(8px);
    transition: background-color var(--transition-fast);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-s);
    gap: var(--space-m);
  }

  .site-header__brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    letter-spacing: var(--tracking-tight);
  }

  .brand-tagline {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-s);
  }

  .site-nav__link {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .site-nav__link:hover {
    color: var(--color-accent);
    background-color: var(--color-surface);
  }

  .site-nav__link--active {
    color: var(--color-accent);
    font-weight: var(--weight-semibold);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  /* Hamburger Button */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    padding: 6px;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: border-color var(--transition-fast);
  }

  .hamburger:hover {
    border-color: var(--color-accent);
  }

  .hamburger__bar {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--color-text-secondary);
    border-radius: 2px;
    transition: all 0.25s ease;
    transform-origin: center;
  }

  /* Open state — animate to X */
  .hamburger[aria-expanded="true"] .hamburger__bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hamburger[aria-expanded="true"] .hamburger__bar:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .hamburger[aria-expanded="true"] .hamburger__bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile Drawer */
  .mobile-drawer {
    display: none;
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.3s ease, opacity 0.2s ease;
    opacity: 0;
    border-top: 1px solid var(--color-border);
    background-color: var(--color-bg);
  }

  .mobile-drawer.open {
    max-height: 400px;
    opacity: 1;
  }

  .mobile-nav__list {
    display: flex;
    flex-direction: column;
    padding: var(--space-s) var(--space-m) var(--space-m);
    gap: var(--space-2xs);
  }

  .mobile-nav__link {
    display: block;
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: var(--space-xs) var(--space-s);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .mobile-nav__link:hover {
    color: var(--color-accent);
    background-color: var(--color-surface);
  }

  .mobile-nav__link--active {
    color: var(--color-accent);
    background-color: color-mix(in oklch, var(--color-accent) 8%, transparent);
    font-weight: var(--weight-semibold);
  }

  @media (max-width: 640px) {
    .brand-tagline {
      display: none;
    }
    .site-nav {
      display: none;
    }
    .hamburger {
      display: flex;
    }
    .mobile-drawer {
      display: block;
    }
  }
</style>

<script>
  function initHamburger() {
    const btn = document.getElementById("hamburgerBtn") as HTMLButtonElement | null;
    const drawer = document.getElementById("mobileDrawer") as HTMLElement | null;
    if (!btn || !drawer) return;

    btn.addEventListener("click", () => {
      const isOpen = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!isOpen));
      drawer.setAttribute("aria-hidden", String(isOpen));
      drawer.classList.toggle("open", !isOpen);
    });

    // Close drawer when a nav link is clicked
    drawer.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        btn.setAttribute("aria-expanded", "false");
        drawer.setAttribute("aria-hidden", "true");
        drawer.classList.remove("open");
      });
    });
  }

  initHamburger();
  document.addEventListener("astro:after-swap", initHamburger);
</script>
