---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../utils/posts";
import { getCollection } from "astro:content";

const allPosts = await getPublishedPosts();
const allTopics = await getCollection("topics");
const allProjects = await getCollection("projects");

const graphNodes = [
  ...allTopics.map((t) => ({
    id: t.id,
    label: t.data.title,
    type: "topic",
    summary: t.data.summary,
    url: `/topics/${t.id}`,
    radius: 18,
    topics: t.data.related || [],
  })),
  ...allPosts.map((p) => ({
    id: p.id,
    label: p.data.title,
    type: "post",
    summary: p.data.excerpt || "",
    url: `/writing/${p.id}`,
    radius: 9,
    topics: p.data.topics || [],
    tags: p.data.tags || [],
  })),
  ...allProjects.map((proj) => ({
    id: proj.id,
    label: proj.data.title,
    type: "project",
    summary: proj.data.summary,
    url: proj.data.repo || "/about",
    radius: 12,
    topics: proj.data.topics || [],
  })),
];
---

<BaseLayout
  title="Knowledge Graph Explorer | Karim Bhalwani"
  description="Interactive network map exploring interconnected systems, AI verification principles, and technical blog posts."
>
  <div class="container container-wide stack stack-m" style="margin-top: var(--space-xl)">
    <header class="stack stack-xs">
      <p class="kicker">Interactive Visualization</p>
      <h1>Knowledge Graph Explorer</h1>
      <p class="lead measure">
        Explore relationships between architectural principles, systems engineering blog posts, and live projects. Drag nodes to inspect links, search nodes, or click to open.
      </p>
    </header>

    <!-- Explorer Toolbar -->
    <div class="explorer-toolbar cluster" style="justify-content: space-between; align-items: center">
      <div class="graph-search-box">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="text"
          id="graphSearchInput"
          class="graph-search-input"
          placeholder="Filter graph nodes..."
          aria-label="Filter graph nodes"
          autocomplete="off"
        />
        <button type="button" id="clearGraphSearchBtn" class="graph-clear-btn" style="display:none" title="Clear filter">✕</button>
      </div>

      <div class="graph-controls cluster" style="--cluster-gap: var(--space-3xs)">
        <button type="button" id="resetLayoutBtn" class="graph-btn" title="Reset node positions">⟲ Reset View</button>
      </div>
    </div>

    <!-- Interactive Canvas & Sidebar -->
    <div class="explorer-layout">
      <div class="explorer-canvas-container">
        <canvas id="explorerCanvas" class="explorer-canvas" aria-label="Interactive knowledge graph"></canvas>
        <div class="canvas-legend cluster" style="--cluster-gap: var(--space-s)">
          <span class="legend-item"><span class="legend-dot legend-dot--topic"></span> Topic Hub</span>
          <span class="legend-item"><span class="legend-dot legend-dot--post"></span> Blog Post</span>
          <span class="legend-item"><span class="legend-dot legend-dot--project"></span> Architecture System</span>
        </div>
      </div>

      <div class="explorer-inspector" id="explorerInspector">
        <div class="inspector-header">
          <p class="kicker" style="margin-bottom: 0">Selected Node</p>
          <button type="button" id="inspectorDeselectBtn" class="btn-clear-selection" style="display: none" title="Clear selection">✕ Deselect</button>
        </div>
        <h3 id="inspectorTitle">Select a node</h3>
        <p id="inspectorType" class="muted">Click any node in the map to view connections.</p>
        <p id="inspectorSummary" style="margin-block: var(--space-s)"></p>
        <a id="inspectorLink" href="#" class="btn btn--ghost" style="display: none">View Page →</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .explorer-toolbar {
    padding: var(--space-xs) var(--space-s);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    gap: var(--space-s);
  }

  .graph-search-box {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1;
    max-width: 24rem;
  }

  .graph-search-box svg {
    position: absolute;
    left: var(--space-xs);
    color: var(--color-text-muted);
  }

  .graph-search-input {
    width: 100%;
    padding: 0.35rem 2rem 0.35rem 2rem;
    font-family: var(--font-body);
    font-size: 0.82rem;
    color: var(--color-text);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    outline: none;
    transition: all var(--transition-fast);
  }

  .graph-search-input:focus {
    border-color: var(--color-accent);
  }

  .graph-clear-btn {
    position: absolute;
    right: var(--space-xs);
    background: none;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    font-size: 0.75rem;
  }

  .graph-btn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-bg);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .graph-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .explorer-layout {
    display: grid;
    grid-template-columns: 1fr 20rem;
    gap: var(--space-m);
    align-items: start;
  }

  .explorer-canvas-container {
    position: relative;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    overflow: hidden;
  }

  .explorer-canvas {
    width: 100%;
    height: 580px;
    display: block;
    cursor: grab;
  }

  .explorer-canvas:active {
    cursor: grabbing;
  }

  .canvas-legend {
    position: absolute;
    bottom: var(--space-s);
    left: var(--space-s);
    padding: var(--space-3xs) var(--space-xs);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .legend-dot--topic {
    background-color: #e09f67;
  }
  .legend-dot--post {
    background-color: #6fa882;
  }
  .legend-dot--project {
    background-color: #5c9df5;
  }

  .explorer-inspector {
    padding: var(--space-m);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
  }

  .inspector-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2xs);
  }

  .btn-clear-selection {
    background: none;
    border: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .btn-clear-selection:hover {
    color: var(--color-text);
    border-color: var(--color-border-hover);
    background-color: var(--color-bg);
  }

  @media (max-width: 850px) {
    .explorer-layout {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline define:vars={{ graphNodes }}>
  function initExplorer() {
    const canvas = document.getElementById("explorerCanvas");
    if (!canvas) return;

    const ctx = canvas.getContext("2d");
    const dpr = window.devicePixelRatio || 1;

    function resize() {
      const rect = canvas.getBoundingClientRect();
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      ctx.scale(dpr, dpr);
    }
    resize();

    const rect = canvas.getBoundingClientRect();
    let width = rect.width;
    let height = rect.height;

    // Position nodes radially around the center
    function initNodePositions() {
      const topics = graphNodes.filter((n) => n.type === "topic");
      const nonTopics = graphNodes.filter((n) => n.type !== "topic");

      const nodeMap = [];

      // Place topics in inner ring
      topics.forEach((t, i) => {
        const angle = (i / topics.length) * Math.PI * 2 - Math.PI / 2;
        const r = Math.min(width, height) * 0.22;
        nodeMap.push({
          ...t,
          x: width / 2 + Math.cos(angle) * r,
          y: height / 2 + Math.sin(angle) * r,
          vx: 0,
          vy: 0,
        });
      });

      // Place posts and projects in outer ring
      nonTopics.forEach((p, i) => {
        const angle = (i / nonTopics.length) * Math.PI * 2;
        const r = Math.min(width, height) * 0.38 + (i % 2 === 0 ? 25 : -25);
        nodeMap.push({
          ...p,
          x: width / 2 + Math.cos(angle) * r + (Math.random() - 0.5) * 20,
          y: height / 2 + Math.sin(angle) * r + (Math.random() - 0.5) * 20,
          vx: 0,
          vy: 0,
        });
      });

      return nodeMap;
    }

    // Build resilient link network
    function buildLinks(currentNodes) {
      const links = [];
      const topics = currentNodes.filter((n) => n.type === "topic");
      const nonTopics = currentNodes.filter((n) => n.type !== "topic");

      // 1. Connect posts and projects to their matching topics
      nonTopics.forEach((n) => {
        let connectedCount = 0;
        const nodeTopics = n.topics || [];
        const nodeTags = (n.tags || []).map((t) => t.toLowerCase());

        topics.forEach((t) => {
          const isTopicMatch = nodeTopics.includes(t.id);
          const isTagMatch = nodeTags.some(
            (tag) => t.id.includes(tag) || tag.includes(t.id) || t.label.toLowerCase().includes(tag)
          );

          if (isTopicMatch || isTagMatch) {
            links.push({ source: n, target: t, distance: 95 });
            connectedCount++;
          }
        });

        // Fail-safe: If no connection was found, connect to the first topic
        if (connectedCount === 0 && topics.length > 0) {
          links.push({ source: n, target: topics[0], distance: 95 });
        }
      });

      // 2. Interconnect topic hubs into a backbone mesh
      for (let i = 0; i < topics.length; i++) {
        const current = topics[i];
        const next = topics[(i + 1) % topics.length];
        if (current && next && current !== next) {
          links.push({ source: current, target: next, distance: 140, isBackbone: true });
        }
      }

      return links;
    }

    let nodes = initNodePositions();
    let links = buildLinks(nodes);

    let hoveredNode = null;
    let selectedNode = null;
    let draggedNode = null;
    let searchQuery = "";

    function stepPhysics() {
      // 1. Node Repulsion
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const a = nodes[i];
          const b = nodes[j];
          const dx = b.x - a.x;
          const dy = b.y - a.y;
          const distSq = dx * dx + dy * dy + 25;
          const dist = Math.sqrt(distSq);
          if (dist < 260) {
            const force = 1200 / distSq;
            const fx = (dx / dist) * force;
            const fy = (dy / dist) * force;
            a.vx -= fx;
            a.vy -= fy;
            b.vx += fx;
            b.vy += fy;
          }
        }
      }

      // 2. Link Spring Forces
      links.forEach((l) => {
        const dx = l.target.x - l.source.x;
        const dy = l.target.y - l.source.y;
        const dist = Math.sqrt(dx * dx + dy * dy) || 1;
        const targetDist = l.distance || 100;
        const force = (dist - targetDist) * (l.isBackbone ? 0.025 : 0.018);
        const fx = (dx / dist) * force;
        const fy = (dy / dist) * force;

        l.source.vx += fx;
        l.source.vy += fy;
        l.target.vx -= fx;
        l.target.vy -= fy;
      });

      // 3. Center Gravity & Boundary Clamping
      const cx = width / 2;
      const cy = height / 2;
      nodes.forEach((n) => {
        if (n === draggedNode) return;

        // Gentle pull to center
        n.vx += (cx - n.x) * 0.0035;
        n.vy += (cy - n.y) * 0.0035;

        // Velocity damping
        n.vx *= 0.88;
        n.vy *= 0.88;

        n.x += n.vx;
        n.y += n.vy;

        const pad = n.radius + 18;
        n.x = Math.max(pad, Math.min(width - pad, n.x));
        n.y = Math.max(pad, Math.min(height - pad, n.y));
      });
    }

    function render() {
      stepPhysics();
      ctx.clearRect(0, 0, width, height);

      const isDark = document.documentElement.dataset.theme === "dark";
      const activeNode = selectedNode || hoveredNode;

      // Active neighborhood
      const connectedNodeIds = new Set();
      const connectedLinkSet = new Set();

      if (activeNode) {
        connectedNodeIds.add(activeNode.id);
        links.forEach((l) => {
          if (l.source.id === activeNode.id || l.target.id === activeNode.id) {
            connectedNodeIds.add(l.source.id);
            connectedNodeIds.add(l.target.id);
            connectedLinkSet.add(l);
          }
        });
      }

      // Search matching set
      const searchMatchIds = new Set();
      if (searchQuery) {
        nodes.forEach((n) => {
          if (
            n.label.toLowerCase().includes(searchQuery) ||
            (n.summary && n.summary.toLowerCase().includes(searchQuery))
          ) {
            searchMatchIds.add(n.id);
          }
        });
      }

      // 1. Draw Links
      if (!activeNode && !searchQuery) {
        ctx.beginPath();
        ctx.strokeStyle = isDark ? "rgba(255, 255, 255, 0.12)" : "rgba(0, 0, 0, 0.09)";
        ctx.lineWidth = 1.2;
        links.forEach((l) => {
          ctx.moveTo(l.source.x, l.source.y);
          ctx.lineTo(l.target.x, l.target.y);
        });
        ctx.stroke();
      } else {
        // Dimmed links
        ctx.beginPath();
        ctx.strokeStyle = isDark ? "rgba(255, 255, 255, 0.03)" : "rgba(0, 0, 0, 0.03)";
        ctx.lineWidth = 0.8;
        links.forEach((l) => {
          if (!connectedLinkSet.has(l)) {
            ctx.moveTo(l.source.x, l.source.y);
            ctx.lineTo(l.target.x, l.target.y);
          }
        });
        ctx.stroke();

        // Highlighted active links
        if (connectedLinkSet.size > 0) {
          ctx.beginPath();
          ctx.strokeStyle = isDark ? "rgba(224, 159, 103, 0.95)" : "rgba(184, 93, 25, 0.9)";
          ctx.lineWidth = 2.4;
          connectedLinkSet.forEach((l) => {
            ctx.moveTo(l.source.x, l.source.y);
            ctx.lineTo(l.target.x, l.target.y);
          });
          ctx.stroke();
        }
      }

      // 2. Draw Nodes
      nodes.forEach((n) => {
        const isActive = activeNode ? n.id === activeNode.id : false;
        const isConnected = activeNode ? connectedNodeIds.has(n.id) : true;
        const isSearchMatch = searchQuery ? searchMatchIds.has(n.id) : true;

        if (searchQuery) {
          ctx.globalAlpha = isSearchMatch ? 1.0 : 0.12;
        } else if (activeNode) {
          if (isActive) ctx.globalAlpha = 1.0;
          else if (isConnected) ctx.globalAlpha = 0.95;
          else ctx.globalAlpha = 0.18;
        } else {
          ctx.globalAlpha = 1.0;
        }

        ctx.beginPath();
        ctx.arc(n.x, n.y, n.radius, 0, Math.PI * 2);

        if (n.type === "topic") ctx.fillStyle = isDark ? "#e09f67" : "#b85d19";
        else if (n.type === "project") ctx.fillStyle = isDark ? "#5c9df5" : "#2b6cb0";
        else ctx.fillStyle = isDark ? "#6fa882" : "#3b7a54";

        ctx.fill();

        // Rings
        if (isActive || (searchQuery && isSearchMatch)) {
          ctx.lineWidth = 3.5;
          ctx.strokeStyle = isDark ? "#ffffff" : "#111111";
          ctx.stroke();
        } else if (activeNode && isConnected) {
          ctx.lineWidth = 1.8;
          ctx.strokeStyle = isDark ? "rgba(255, 255, 255, 0.8)" : "rgba(0, 0, 0, 0.65)";
          ctx.stroke();
        }

        // Labels
        const shouldShowLabel = activeNode
          ? isConnected
          : (searchQuery ? isSearchMatch : (n.type === "topic" || n === hoveredNode));

        if (shouldShowLabel) {
          ctx.font = isActive
            ? "700 12px system-ui, sans-serif"
            : "600 11px system-ui, sans-serif";
          ctx.fillStyle = isDark ? "#f0ebe1" : "#1f1d1a";
          ctx.textAlign = "center";
          const labelText = n.label.length > 26 ? n.label.slice(0, 25) + "…" : n.label;
          ctx.fillText(labelText, n.x, n.y + n.radius + 13);
        }

        ctx.globalAlpha = 1.0;
      });

      requestAnimationFrame(render);
    }

    render();

    function getMousePos(e) {
      const r = canvas.getBoundingClientRect();
      return { x: e.clientX - r.left, y: e.clientY - r.top };
    }

    function updateInspector(node) {
      const title = document.getElementById("inspectorTitle");
      const type = document.getElementById("inspectorType");
      const summary = document.getElementById("inspectorSummary");
      const link = document.getElementById("inspectorLink");
      const deselectBtn = document.getElementById("inspectorDeselectBtn");
      if (!title) return;

      if (node) {
        title.textContent = node.label;
        type.textContent = `${node.type.toUpperCase()} NODE`;
        summary.textContent = node.summary || "No summary provided.";
        if (node.url) {
          link.href = node.url;
          link.style.display = "inline-flex";
        } else {
          link.style.display = "none";
        }
        if (deselectBtn) deselectBtn.style.display = "inline-block";
      } else {
        title.textContent = "Select a node";
        type.textContent = "Click any node in the map to view connections.";
        summary.textContent = "";
        link.style.display = "none";
        if (deselectBtn) deselectBtn.style.display = "none";
      }
    }

    // Search filter listener
    const searchInput = document.getElementById("graphSearchInput");
    const clearSearchBtn = document.getElementById("clearGraphSearchBtn");
    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        searchQuery = e.target.value.trim().toLowerCase();
        if (clearSearchBtn) {
          clearSearchBtn.style.display = searchQuery ? "inline-block" : "none";
        }
      });
    }

    if (clearSearchBtn && searchInput) {
      clearSearchBtn.addEventListener("click", () => {
        searchInput.value = "";
        searchQuery = "";
        clearSearchBtn.style.display = "none";
      });
    }

    // Reset Layout Button — restores fresh nodes and rebuilds connected links cleanly
    const resetBtn = document.getElementById("resetLayoutBtn");
    if (resetBtn) {
      resetBtn.addEventListener("click", () => {
        nodes = initNodePositions();
        links = buildLinks(nodes);
        selectedNode = null;
        updateInspector(null);
      });
    }

    const deselectBtn = document.getElementById("inspectorDeselectBtn");
    if (deselectBtn) {
      deselectBtn.addEventListener("click", () => {
        selectedNode = null;
        updateInspector(null);
      });
    }

    canvas.addEventListener("mousemove", (e) => {
      const pos = getMousePos(e);
      let found = null;
      for (const n of nodes) {
        const dx = n.x - pos.x;
        const dy = n.y - pos.y;
        if (Math.sqrt(dx * dx + dy * dy) < n.radius + 8) {
          found = n;
          break;
        }
      }
      hoveredNode = found;
      canvas.style.cursor = found ? "pointer" : (draggedNode ? "grabbing" : "grab");

      if (draggedNode) {
        draggedNode.x = pos.x;
        draggedNode.y = pos.y;
      }
    });

    canvas.addEventListener("mouseleave", () => {
      hoveredNode = null;
      if (!selectedNode) {
        canvas.style.cursor = "grab";
      }
    });

    canvas.addEventListener("mousedown", (e) => {
      const pos = getMousePos(e);
      let clickedNode = null;
      for (const n of nodes) {
        const dx = n.x - pos.x;
        const dy = n.y - pos.y;
        if (Math.sqrt(dx * dx + dy * dy) < n.radius + 8) {
          clickedNode = n;
          break;
        }
      }
      if (clickedNode) {
        draggedNode = clickedNode;
        selectedNode = clickedNode;
        updateInspector(clickedNode);
      } else {
        selectedNode = null;
        updateInspector(null);
      }
    });

    // Touch support for mobile devices
    canvas.addEventListener("touchstart", (e) => {
      if (!e.touches || e.touches.length === 0) return;
      const touch = e.touches[0];
      const r = canvas.getBoundingClientRect();
      const pos = { x: touch.clientX - r.left, y: touch.clientY - r.top };
      let clickedNode = null;
      for (const n of nodes) {
        const dx = n.x - pos.x;
        const dy = n.y - pos.y;
        if (Math.sqrt(dx * dx + dy * dy) < n.radius + 12) {
          clickedNode = n;
          break;
        }
      }
      if (clickedNode) {
        draggedNode = clickedNode;
        selectedNode = clickedNode;
        updateInspector(clickedNode);
        e.preventDefault();
      } else {
        selectedNode = null;
        updateInspector(null);
      }
    }, { passive: false });

    canvas.addEventListener("touchmove", (e) => {
      if (draggedNode && e.touches && e.touches.length > 0) {
        const touch = e.touches[0];
        const r = canvas.getBoundingClientRect();
        draggedNode.x = touch.clientX - r.left;
        draggedNode.y = touch.clientY - r.top;
        e.preventDefault();
      }
    }, { passive: false });

    canvas.addEventListener("touchend", () => {
      draggedNode = null;
    });

    window.addEventListener("mouseup", () => {
      draggedNode = null;
    });
  }

  initExplorer();
  document.addEventListener("astro:after-swap", initExplorer);
</script>
