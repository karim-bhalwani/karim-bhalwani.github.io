---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../../utils/posts";
import { getCollection } from "astro:content";

const topics = await getCollection("topics");
const allPosts = await getPublishedPosts();

const topicCards = topics.map((topic) => {
  const topicPosts = allPosts
    .filter((p) => (p.data.topics || []).includes(topic.id))
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

  return {
    topic,
    count: topicPosts.length,
    latestPost: topicPosts[0],
  };
});
---

<BaseLayout
  title="Topics | Karim Bhalwani"
  description="Core themes and research areas in AI systems engineering, agent harnesses, and distributed intelligence."
>
  <div class="container stack stack-l" style="margin-top: var(--space-xl)">
    <header class="stack stack-xs">
      <p class="kicker">Index</p>
      <h1>Topics & Knowledge Hubs</h1>
      <p class="lead measure">
        Explore core research areas, architectural patterns, and execution loops organized across {topics.length} central topic hubs.
      </p>
    </header>

    <div class="auto-grid" style="--grid-min: 20rem">
      {
        topicCards.map(({ topic, count, latestPost }) => {
          return (
            <article class="topic-hub-card stack stack-s">
              <div class="topic-hub-card__header cluster" style="justify-content: space-between; align-items: center">
                <span class="kicker">{topic.data.category || "Topic Hub"}</span>
                <span class="badge-count">{count} {count === 1 ? "Post" : "Posts"}</span>
              </div>

              <h2 class="topic-hub-card__title">
                <a href={`/topics/${topic.id}`} class="topic-title-link">
                  {topic.data.title}
                </a>
              </h2>

              <p class="topic-hub-card__summary muted">{topic.data.summary}</p>

              {latestPost && (
                <div class="topic-hub-card__latest">
                  <span class="latest-label">Latest:</span>
                  <a href={`/writing/${latestPost.id}`} class="latest-link">
                    {latestPost.data.title}
                  </a>
                </div>
              )}

              <div class="topic-hub-card__footer cluster" style="justify-content: space-between; align-items: center; margin-top: auto; padding-top: var(--space-xs)">
                <a href={`/topics/${topic.id}`} class="btn btn--ghost" style="font-size: 0.8rem">
                  Explore Hub →
                </a>
                <a href={`/writing?topic=${topic.id}`} class="filter-link" title={`Filter writing by ${topic.data.title}`}>
                  View in Archive
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</BaseLayout>

<style>
  .topic-hub-card {
    padding: var(--space-l);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    transition: all var(--transition-fast);
    display: flex;
    flex-direction: column;
  }

  .topic-hub-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .topic-hub-card__title {
    font-size: var(--step-2);
    line-height: var(--leading-snug);
    margin-block: var(--space-3xs);
  }

  .topic-title-link {
    color: var(--color-text);
    text-decoration: none;
  }

  .topic-title-link:hover {
    color: var(--color-accent);
  }

  .badge-count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.15rem 0.5rem;
    background-color: color-mix(in oklch, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
    border: 1px solid color-mix(in oklch, var(--color-accent) 30%, transparent);
    border-radius: var(--radius-sm);
    font-weight: var(--weight-medium);
  }

  .topic-hub-card__summary {
    font-size: var(--step--1);
    line-height: var(--leading-normal);
  }

  .topic-hub-card__latest {
    font-size: 0.82rem;
    padding: var(--space-2xs) var(--space-xs);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    display: flex;
    gap: 0.4rem;
    align-items: baseline;
    overflow: hidden;
  }

  .latest-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .latest-link {
    color: var(--color-text-secondary);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .latest-link:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .filter-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .filter-link:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }
</style>
