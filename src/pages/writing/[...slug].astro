---
import { getCollection, render } from "astro:content";
import { getPublishedPosts } from "../../utils/posts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tag from "../../components/Tag.astro";

export async function getStaticPaths() {
  const sorted = await getPublishedPosts();

  return sorted.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      // Older post (chronologically previous)
      prevPost: i < sorted.length - 1 ? sorted[i + 1] : null,
      // Newer post (chronologically next)
      nextPost: i > 0 ? sorted[i - 1] : null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { data } = post;
const { Content } = await render(post);

const topics = await getCollection("topics");
const topicMap = new Map(topics.map((t) => [t.id, t.data.title]));

const postTopics = data.topics || [];
const hubId = postTopics.length > 0 ? postTopics[0] : null;
const hubTitle = hubId ? topicMap.get(hubId) || hubId : null;

const formattedDate = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(new Date(data.date));

const categoryText = Array.isArray(data.categories)
  ? data.categories[0]
  : data.categories || "Article";

// Derive the hero OG image: prefer explicit hero_image, then date-stripped folder
const postFolder = post.id.replace(/^\d{4}-\d{2}-\d{2}-/, "");
const heroImage = data.hero_image || `/assets/${postFolder}/hero-main.webp`;
const publishedTime = new Date(data.date).toISOString();
const modifiedTime = data.updated ? new Date(data.updated).toISOString() : publishedTime;
---

<BaseLayout
  title={`${data.title} | Karim Bhalwani`}
  description={data.excerpt}
  type="article"
  image={heroImage}
  readingTime={data.reading_time}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  authorName={data.author || "Karim Bhalwani"}
  articleTags={data.tags || []}
>
  <!-- Reading Progress Indicator -->
  <div class="reading-progress-track" aria-hidden="true">
    <div class="reading-progress-bar" id="readingProgressBar"></div>
  </div>

  <article class="container container-narrow post stack stack-l" style="margin-top: var(--space-xl)">
    <!-- Article Header -->
    <header class="post-header stack stack-s">
      <div class="cluster" style="justify-content: space-between; align-items: center">
        <div class="cluster" style="--cluster-gap: var(--space-2xs); align-items: center">
          <a href="/writing" class="kicker post-kicker">← All Writing</a>
          <span class="post-kicker-divider">/</span>
          <span class="badge-post">{categoryText}</span>
        </div>
        {hubId && (
          <a href={`/topics/${hubId}`} class="topic-pill">
            Topic: {hubTitle}
          </a>
        )}
      </div>

      <h1 class="post-title">{data.title}</h1>

      {data.excerpt && <p class="post__dek">{data.excerpt}</p>}

      <div class="post-meta-bar cluster" style="justify-content: space-between; align-items: center">
        <div class="post-meta muted cluster" style="--cluster-gap: var(--space-xs); font-size: var(--step--1)">
          <span>By {data.author || "Karim Bhalwani"}</span>
          <span>·</span>
          <time datetime={new Date(data.date).toISOString()}>{formattedDate}</time>
          {data.reading_time && (
            <>
              <span>·</span>
              <span>{data.reading_time} min read</span>
            </>
          )}
        </div>
        <button type="button" class="btn-share" id="shareBtn" title="Copy article link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
          </svg>
          <span id="shareBtnText">Copy Link</span>
        </button>
      </div>

      <!-- Structured Architectural Takeaways for Readers & AI Answer Engines -->
      {data.key_takeaways && data.key_takeaways.length > 0 && (
        <aside class="takeaways-box stack stack-3xs" aria-label="Key Takeaways">
          <div class="takeaways-badge">Architectural Summary &amp; Key Insights</div>
          <ul class="takeaways-list" role="list">
            {data.key_takeaways.map((item: string) => (
              <li>{item}</li>
            ))}
          </ul>
        </aside>
      )}

      <hr class="post-divider" />
    </header>

    <!-- Article Content -->
    <div class="prose" id="postContent">
      <Content />
    </div>

    <!-- Article Footer -->
    <footer class="post-footer stack stack-m">
      <hr class="post-divider" />

      {
        data.tags && data.tags.length > 0 && (
          <div class="stack stack-3xs">
            <span class="muted" style="font-family: var(--font-mono); font-size: 0.78rem">Topics & Tags:</span>
            <div class="cluster" style="--cluster-gap: var(--space-3xs)">
              {data.tags.map((t) => (
                <Tag text={t} href={`/writing?tag=${encodeURIComponent(t)}`} />
              ))}
            </div>
          </div>
        )
      }

      <!-- Next / Previous Post Navigation Cards -->
      {
        (prevPost || nextPost) && (
          <nav class="adjacent-posts-grid" aria-label="Sequential reading">
            {prevPost ? (
              <a href={`/writing/${prevPost.id}`} class="adjacent-card adjacent-card--prev">
                <span class="adjacent-card__direction">← Previous Post</span>
                <span class="adjacent-card__title">{prevPost.data.title}</span>
                {prevPost.data.reading_time && (
                  <span class="adjacent-card__meta">{prevPost.data.reading_time} min read</span>
                )}
                {prevPost.data.excerpt && (
                  <span class="adjacent-card__excerpt">{prevPost.data.excerpt}</span>
                )}
              </a>
            ) : (
              <div class="adjacent-card-placeholder" />
            )}

            {nextPost ? (
              <a href={`/writing/${nextPost.id}`} class="adjacent-card adjacent-card--next">
                <span class="adjacent-card__direction">Next Post →</span>
                <span class="adjacent-card__title">{nextPost.data.title}</span>
                {nextPost.data.reading_time && (
                  <span class="adjacent-card__meta">{nextPost.data.reading_time} min read</span>
                )}
                {nextPost.data.excerpt && (
                  <span class="adjacent-card__excerpt">{nextPost.data.excerpt}</span>
                )}
              </a>
            ) : (
              <div class="adjacent-card-placeholder" />
            )}
          </nav>
        )
      }

      <!-- Knowledge Graph Callout -->
      <a href="/explorer" class="kg-callout">
        <div class="kg-callout__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="5" r="2"/>
            <circle cx="5" cy="19" r="2"/>
            <circle cx="19" cy="19" r="2"/>
            <line x1="12" y1="7" x2="5" y2="17"/>
            <line x1="12" y1="7" x2="19" y2="17"/>
            <line x1="5" y1="19" x2="19" y2="19"/>
          </svg>
        </div>
        <div class="kg-callout__body">
          <span class="kg-callout__title">Explore the Knowledge Graph</span>
          <span class="kg-callout__desc">See how this post connects to every other article on the site.</span>
        </div>
        <span class="kg-callout__arrow">→</span>
      </a>

      <div class="post-navigation cluster" style="justify-content: flex-start; --cluster-gap: var(--space-s); margin-top: var(--space-m)">
        <a href="/writing" class="btn btn--ghost">← Back to All Writing</a>
        {hubId && <a href={`/topics/${hubId}`} class="btn btn--ghost">Explore Topic Hub</a>}
      </div>
    </footer>
  </article>

  <!-- Floating Back to Top Button -->
  <button type="button" id="backToTopBtn" class="back-to-top" aria-label="Scroll back to top" title="Back to top">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
  </button>
</BaseLayout>

<style>
  /* Reading Progress Track */
  .reading-progress-track {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: transparent;
    z-index: 1000;
  }

  .reading-progress-bar {
    height: 100%;
    width: 0%;
    background-color: var(--color-accent);
    transition: width 0.08s ease-out;
  }

  .post-kicker {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .post-kicker:hover {
    color: var(--color-accent);
  }

  .post-kicker-divider {
    color: var(--color-border);
  }

  .badge-post {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background-color: color-mix(in srgb, var(--color-accent) 15%, transparent);
    color: var(--color-accent);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
  }

  .topic-pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    border: 1px solid var(--color-border);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .topic-pill:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .post-title {
    font-size: var(--step-4);
    line-height: var(--leading-tight);
  }

  .post-meta-bar {
    padding-top: var(--space-3xs);
  }

  .btn-share {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-secondary);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .btn-share:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .takeaways-box {
    background-color: color-mix(in srgb, var(--color-surface) 92%, var(--color-bg));
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-md);
    padding: var(--space-s) var(--space-m);
    margin-top: var(--space-s);
  }

  .takeaways-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: var(--space-3xs);
  }

  .takeaways-list {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .takeaways-list li {
    font-family: var(--font-body);
    font-size: var(--step--1);
    line-height: var(--leading-normal);
    color: var(--color-text-secondary);
  }

  .post-divider {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin-block: var(--space-s);
  }

  .post-footer {
    margin-top: var(--space-xl);
  }

  /* Adjacent Post Navigation Cards */
  .adjacent-posts-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-s);
    margin-block: var(--space-m);
  }

  .adjacent-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-m);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .adjacent-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .adjacent-card--next {
    text-align: right;
  }

  .adjacent-card__direction {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
    margin-bottom: var(--space-3xs);
  }

  .adjacent-card__title {
    font-family: var(--font-display);
    font-size: var(--step-0);
    color: var(--color-text);
    line-height: var(--leading-snug);
  }

  .adjacent-card:hover .adjacent-card__title {
    color: var(--color-accent);
  }

  .adjacent-card-placeholder {
    display: block;
  }

  .adjacent-card__meta {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    margin-top: var(--space-3xs);
  }

  .adjacent-card__excerpt {
    font-size: var(--step--1);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    margin-top: var(--space-3xs);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Knowledge Graph Callout */
  .kg-callout {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    padding: var(--space-m) var(--space-l);
    background-color: color-mix(in oklch, var(--color-accent) 6%, var(--color-surface));
    border: 1px solid color-mix(in oklch, var(--color-accent) 30%, var(--color-border));
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-fast);
    margin-block: var(--space-m);
  }

  .kg-callout:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .kg-callout__icon {
    flex-shrink: 0;
    color: var(--color-accent);
    opacity: 0.8;
  }

  .kg-callout__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .kg-callout__title {
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
  }

  .kg-callout:hover .kg-callout__title {
    color: var(--color-accent);
  }

  .kg-callout__desc {
    font-size: var(--step--1);
    color: var(--color-text-secondary);
  }

  .kg-callout__arrow {
    font-size: var(--step-1);
    color: var(--color-accent);
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }

  .kg-callout:hover .kg-callout__arrow {
    transform: translateX(4px);
  }

  /* Back to Top Button */
  .back-to-top {
    position: fixed;
    bottom: var(--space-l);
    right: var(--space-l);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: var(--shadow-md);
    opacity: 0;
    pointer-events: none;
    transform: translateY(10px);
    transition: all var(--transition-normal);
    z-index: 90;
  }

  .back-to-top.visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .back-to-top:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  @media (max-width: 600px) {
    .adjacent-posts-grid {
      grid-template-columns: 1fr;
    }
    .adjacent-card--next {
      text-align: left;
    }
  }
</style>

<script>
  function setupPostInteractions() {
    // 1. Reading Progress Bar
    const progressBar = document.getElementById("readingProgressBar");
    const content = document.getElementById("postContent");

    function updateProgress() {
      if (!progressBar || !content) return;
      const rect = content.getBoundingClientRect();
      const totalHeight = rect.height;
      const windowHeight = window.innerHeight;
      const scrolled = Math.max(0, -rect.top);
      const maxScroll = totalHeight - windowHeight;
      const progress = maxScroll > 0 ? Math.min(100, Math.max(0, (scrolled / maxScroll) * 100)) : 0;
      progressBar.style.width = `${progress}%`;
    }

    window.addEventListener("scroll", updateProgress, { passive: true });
    updateProgress();

    // 2. Back to Top Button
    const topBtn = document.getElementById("backToTopBtn");
    function checkScrollTop() {
      if (!topBtn) return;
      if (window.scrollY > 450) {
        topBtn.classList.add("visible");
      } else {
        topBtn.classList.remove("visible");
      }
    }
    window.addEventListener("scroll", checkScrollTop, { passive: true });
    checkScrollTop();

    if (topBtn) {
      topBtn.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    }

    // 3. Share / Copy Article Link
    const shareBtn = document.getElementById("shareBtn");
    const shareBtnText = document.getElementById("shareBtnText");
    if (shareBtn && shareBtnText) {
      shareBtn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          const originalText = shareBtnText.textContent;
          shareBtnText.textContent = "Copied!";
          setTimeout(() => {
            shareBtnText.textContent = originalText;
          }, 2000);
        } catch (e) {}
      });
    }

    // 4. Code Block Copy Buttons
    const preBlocks = document.querySelectorAll("pre");
    preBlocks.forEach((pre) => {
      if (pre.querySelector(".code-copy-btn")) return;

      const btn = document.createElement("button");
      btn.className = "code-copy-btn";
      btn.type = "button";
      btn.title = "Copy code to clipboard";
      btn.innerHTML = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg><span>Copy</span>`;

      btn.addEventListener("click", async () => {
        const code = pre.querySelector("code")?.textContent || pre.textContent || "";
        try {
          await navigator.clipboard.writeText(code);
          btn.innerHTML = `<span>Copied!</span>`;
          btn.classList.add("copied");
          setTimeout(() => {
            btn.innerHTML = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg><span>Copy</span>`;
            btn.classList.remove("copied");
          }, 2000);
        } catch (err) {}
      });

      pre.style.position = "relative";
      pre.appendChild(btn);
    });

    // 5. Heading Permalinks / Anchor Deep Links
    const headings = document.querySelectorAll("#postContent h2[id], #postContent h3[id]");
    headings.forEach((h) => {
      if (h.querySelector(".heading-anchor")) return;
      const anchor = document.createElement("a");
      anchor.className = "heading-anchor";
      anchor.href = `#${h.id}`;
      anchor.setAttribute("aria-label", `Link to ${h.textContent}`);
      anchor.textContent = "#";
      h.appendChild(anchor);
    });
  }

  setupPostInteractions();
  document.addEventListener("astro:after-swap", setupPostInteractions);
</script>
