---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import MiniGraph from "../components/graph/MiniGraph.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
const recentPosts = sortedPosts.slice(0, 5);
const topics = await getCollection("topics");
---

<BaseLayout
  title="Karim Bhalwani | Writing on AI Systems & Agentic Architecture"
  description="Personal writing on AI systems reliability, agentic architectures, context engineering, and production systems design. These are my own ideas and independent learning."
>
  <div class="container stack stack-l" style="margin-top: var(--space-xl)">

    <!-- Hero -->
    <section class="hero stack stack-s">
      <p class="kicker">Personal Writing · AI Systems & Agentic Architecture</p>
      <h1 class="hero__title">
        Thinking out loud about how AI systems actually behave in practice.
      </h1>
      <p class="hero__lead measure">
        I write about agent control layers, context engineering, verification, and the systems-level problems
        that surface when you put capable models into production. This is independent learning and personal exploration.
        Not a product, not a company.
      </p>
      <div class="hero__actions cluster" style="--cluster-gap: var(--space-s)">
        <a href="/writing" class="btn">Read the Essays</a>
        <a href="/about" class="btn btn--ghost">About</a>
      </div>

      <!-- Disclosure -->
      <aside class="disclosure">
        <p>
          <strong>Personal blog.</strong> The views, analyses, and opinions expressed here are entirely my own and do not represent, reflect, or relate to my employer or any organization I am affiliated with.
        </p>
      </aside>
    </section>

    <!-- Interactive Knowledge Graph -->
    <section class="section">
      <MiniGraph />
    </section>

    <!-- Topics -->
    <section class="section stack stack-s">
      <div class="section-head">
        <h2>Topics</h2>
        <a href="/topics" class="section-head__more">All topics →</a>
      </div>
      <div class="auto-grid" style="--grid-min: 16rem">
        {
          topics.map((t) => (
            <div class="topic-card">
              <span class="kicker">{t.data.category || "Topic"}</span>
              <h3 class="topic-card__title">
                <a href={`/topics/${t.id}`}>{t.data.title}</a>
              </h3>
              <p class="muted">{t.data.summary}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Recent Writing -->
    <section class="section stack stack-s">
      <div class="section-head">
        <h2>Recent Essays</h2>
        <a href="/writing" class="section-head__more">Complete Archive ({sortedPosts.length}) →</a>
      </div>
      <div class="stack stack-m">
        {
          recentPosts.map((post) => (
            <PostCard
              title={post.data.title}
              slug={post.id}
              date={post.data.date}
              reading_time={post.data.reading_time}
              excerpt={post.data.excerpt}
              tags={post.data.tags}
              categories={post.data.categories}
            />
          ))
        }
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .hero__title {
    font-size: var(--step-4);
    max-width: 42rem;
  }

  .hero__lead {
    font-size: var(--step-1);
    color: var(--color-text-secondary);
  }

  /* Disclosure notice */
  .disclosure {
    padding: var(--space-xs) var(--space-s);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-text-muted);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
    max-width: var(--width-prose);
  }

  .disclosure p {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
  }

  .disclosure strong {
    color: var(--color-text-secondary);
    font-weight: var(--weight-semibold);
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-2xs);
    margin-bottom: var(--space-m);
  }

  .section-head__more {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-accent);
    text-decoration: none;
  }

  .section-head__more:hover {
    text-decoration: underline;
  }

  .topic-card {
    padding: var(--space-m);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    transition: all var(--transition-fast);
  }

  .topic-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .topic-card__title a {
    font-size: var(--step-1);
    color: var(--color-text);
    text-decoration: none;
  }

  .topic-card__title a:hover {
    color: var(--color-accent);
  }
</style>
