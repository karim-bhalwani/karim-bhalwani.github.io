---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import MiniGraph from "../components/graph/MiniGraph.astro";
import { getPublishedPosts } from "../utils/posts";
import { getCollection } from "astro:content";

const sortedPosts = await getPublishedPosts();
const allPosts = sortedPosts;
const featuredPosts = sortedPosts.filter((p) => p.data.featured);
const nonFeaturedPosts = sortedPosts.filter((p) => !p.data.featured);
const recentPosts = nonFeaturedPosts.slice(0, 5);
const topics = await getCollection("topics");
---

<BaseLayout
  title="Karim Bhalwani | Writing on AI Systems & Agentic Architecture"
  description="Personal writing on AI systems reliability, agentic architectures, context engineering, and production systems design. These are my own ideas and independent learning."
>
  <div class="container stack stack-l" style="margin-top: var(--space-xl)">

    <!-- Hero -->
    <section class="hero stack stack-s">
      <p class="kicker">Personal Writing · AI Systems & Agentic Architecture</p>
      <h1 class="hero__title">
        Thinking out loud about how AI systems actually behave in practice.
      </h1>
      <p class="hero__lead measure">
        I write about agent control layers, context engineering, verification, and the systems-level problems
        that surface when you put capable models into production. This is independent learning and personal exploration.
        Not a product, not a company.
      </p>
      <div class="hero__actions cluster" style="--cluster-gap: var(--space-s)">
        <a href="/writing" class="btn">Read the Blog</a>
        <a href="/about" class="btn btn--ghost">About</a>
      </div>

      <!-- Disclosure -->
      <aside class="disclosure">
        <p>
          <strong>Personal blog.</strong> The views, analyses, and opinions expressed here are entirely my own and do not represent, reflect, or relate to my employer or any organization I am affiliated with.
        </p>
      </aside>
    </section>

    <!-- Interactive Knowledge Graph -->
    <section class="section stack stack-s">
      <div class="section-head">
        <h2>Knowledge Graph</h2>
        <a href="/explorer" class="section-head__more">Open Explorer →</a>
      </div>
      <MiniGraph />
    </section>

    <!-- Featured Posts (only renders when posts have featured: true) -->
    {featuredPosts.length > 0 && (
      <section class="section stack stack-s">
        <div class="section-head">
          <h2>Featured</h2>
          <a href="/writing" class="section-head__more">All writing →</a>
        </div>
        <div class="featured-grid">
          {featuredPosts.map((post) => (
            <a href={`/writing/${post.id}`} class="featured-card">
              <div class="featured-card__meta cluster" style="--cluster-gap: var(--space-xs)">
                <span class="kicker">{Array.isArray(post.data.categories) ? post.data.categories[0] : post.data.categories || "AI Systems"}</span>
                <time datetime={new Date(post.data.date).toISOString()} class="muted" style="font-size: var(--step--1)">
                  {new Intl.DateTimeFormat("en-US", { year: "numeric", month: "short", day: "numeric" }).format(new Date(post.data.date))}
                  {post.data.reading_time ? ` · ${post.data.reading_time} min read` : ""}
                </time>
              </div>
              <h3 class="featured-card__title">{post.data.title}</h3>
              {post.data.excerpt && <p class="featured-card__excerpt">{post.data.excerpt}</p>}
              <span class="featured-card__cta">Read post →</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Topics -->
    <section class="section stack stack-s">
      <div class="section-head">
        <h2>Topics</h2>
        <a href="/topics" class="section-head__more">All topics →</a>
      </div>
      <div class="auto-grid" style="--grid-min: 16rem">
        {
          topics.map((t) => {
            const topicCount = allPosts.filter((p) => (p.data.topics || []).includes(t.id)).length;
            return (
              <div class="topic-card">
                <div class="cluster" style="justify-content: space-between; align-items: center">
                  <span class="kicker">{t.data.category || "Topic"}</span>
                  <span class="topic-count">{topicCount} {topicCount === 1 ? "Post" : "Posts"}</span>
                </div>
                <h3 class="topic-card__title">
                  <a href={`/topics/${t.id}`}>{t.data.title}</a>
                </h3>
                <p class="muted">{t.data.summary}</p>
              </div>
            );
          })
        }
      </div>
    </section>

    <!-- Recent Writing -->
    <section class="section stack stack-s">
      <div class="section-head">
        <h2>Recent Posts</h2>
        <a href="/writing" class="section-head__more">Complete Archive ({sortedPosts.length}) →</a>
      </div>
      <div class="stack stack-m">
        {
          recentPosts.map((post) => (
            <PostCard
              title={post.data.title}
              slug={post.id}
              date={post.data.date}
              reading_time={post.data.reading_time}
              excerpt={post.data.excerpt}
              tags={post.data.tags}
              categories={post.data.categories}
            />
          ))
        }
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .hero__title {
    font-size: var(--step-4);
    max-width: 42rem;
  }

  .hero__lead {
    font-size: var(--step-1);
    color: var(--color-text-secondary);
  }

  /* Disclosure notice */
  .disclosure {
    padding: var(--space-xs) var(--space-s);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-text-muted);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
    max-width: var(--width-prose);
  }

  .disclosure p {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
  }

  .disclosure strong {
    color: var(--color-text-secondary);
    font-weight: var(--weight-semibold);
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-2xs);
    margin-bottom: var(--space-m);
  }

  .section-head__more {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-accent);
    text-decoration: none;
  }

  .section-head__more:hover {
    text-decoration: underline;
  }

  .topic-card {
    padding: var(--space-m);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    transition: all var(--transition-fast);
  }

  .topic-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .topic-card__title a {
    font-size: var(--step-1);
    color: var(--color-text);
    text-decoration: none;
  }

  .topic-card__title a:hover {
    color: var(--color-accent);
  }

  .topic-count {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-accent);
    padding: 0.1rem 0.4rem;
    background-color: color-mix(in oklch, var(--color-accent) 10%, transparent);
    border: 1px solid color-mix(in oklch, var(--color-accent) 25%, transparent);
    border-radius: var(--radius-sm);
  }

  /* Featured posts grid */
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: var(--space-m);
  }

  .featured-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-l);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .featured-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .featured-card__title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: var(--leading-snug);
    color: var(--color-text);
  }

  .featured-card:hover .featured-card__title {
    color: var(--color-accent);
  }

  .featured-card__excerpt {
    font-size: var(--step--1);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    flex: 1;
  }

  .featured-card__cta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-accent);
    margin-top: var(--space-2xs);
  }
</style>
