---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 | Page Not Found | Karim Bhalwani">
  <div class="container container-narrow stack stack-m" style="margin-top: var(--space-2xl); text-align: center;">
    <p class="kicker">404 Error</p>
    <h1>Page Not Found</h1>
    <p class="lead">
      The requested node or article could not be located in this knowledge graph.
    </p>
    <div style="margin-top: var(--space-m)">
      <a href="/" class="btn">Return to Home</a>
      <a href="/writing" class="btn btn--ghost">Browse Archive</a>
    </div>
  </div>
</BaseLayout>
